<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reading music by its path, as on a desk: the system's right to music and audio
         (Android 13 on; "files and media" before), asked for in a dialog of its own. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- ("All files access", which reads what lies beside the music too, is asked for
         only by the build that is installed by hand: src/direct/AndroidManifest.xml.) -->
    <!-- Playing on with the app off screen: a foreground service and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Media servers of the home network (DLNA): finding them and reading from them.
         Nothing is sent anywhere else, and nothing before the network page is opened. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- The one screen: a native activity that loads the app (liboneum.so). What
             changes on the way (rotation, the theme, a keyboard, bold text, a SIM) is
             handled by the app, so the activity is not made anew for it: made anew, it
             ends the process, and the music with it.
             The Back key comes to the app as a key (it decides what Back means on
             each page), so the system's own handling of Back, which an app that
             targets Android 16 gets unless it says no, is declined. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|fontWeightAdjustment|colorMode|mcc|mnc|touchscreen|grammaticalGender"
            android:enableOnBackInvokedCallback="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <meta-data
                android:name="android.app.lib_name"
                android:value="oneum" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for music files. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Opens the app again after its process ended itself (a lost graphics
             device); in a process of its own, because it must outlive the app's. -->
        <activity
            android:name=".RelaunchActivity"
            android:exported="false"
            android:process=":relaunch"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The home screen widget: the song that plays. The launcher asks it what to
             show when a widget is added and after the phone started. -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget" />
        </receiver>

        <!-- What the widget's buttons start: it shows nothing, tells the app if the
             app is there, and opens it if not. -->
        <activity
            android:name=".WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
