<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>OnEum</string>
  <key>CFBundleDisplayName</key><string>OnEum</string>
  <key>CFBundleIdentifier</key><string>app.oneum.OnEum</string>
  <key>CFBundleExecutable</key><string>OnEum</string>
  <key>CFBundleIconFile</key><string>OnEum</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>CFBundleDevelopmentRegion</key><string>ko</string>
  <key>CFBundleLocalizations</key>
  <array><string>ko</string><string>en</string></array>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.music</string>
  <key>LSArchitecturePriority</key>
  <array><string>arm64</string></array>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSHumanReadableCopyright</key><string>OnEum — BSD Zero Clause License (0BSD)</string>
  <key>NSDownloadsFolderUsageDescription</key><string>추가한 음악 폴더의 파일을 읽어 재생합니다. 파일을 바꾸지 않습니다.</string>
  <key>NSDocumentsFolderUsageDescription</key><string>추가한 음악 폴더의 파일을 읽어 재생합니다. 파일을 바꾸지 않습니다.</string>
  <key>NSDesktopFolderUsageDescription</key><string>추가한 음악 폴더의 파일을 읽어 재생합니다. 파일을 바꾸지 않습니다.</string>
  <key>NSRemovableVolumesUsageDescription</key><string>추가한 음악 폴더의 파일을 읽어 재생합니다. 파일을 바꾸지 않습니다.</string>
  <key>NSNetworkVolumesUsageDescription</key><string>추가한 음악 폴더의 파일을 읽어 재생합니다. 파일을 바꾸지 않습니다.</string>
  <key>NSLocalNetworkUsageDescription</key><string>같은 네트워크의 미디어 서버(DLNA)를 찾아 그 음악을 재생합니다. 네트워크 화면을 열 때만 씁니다.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Audio File</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mp3</string>
        <string>org.xiph.flac</string>
        <string>com.microsoft.waveform-audio</string>
        <string>public.aiff-audio</string>
        <string>public.aifc-audio</string>
        <string>com.apple.m4a-audio</string>
        <string>public.mpeg-4-audio</string>
        <string>org.xiph.ogg-audio</string>
        <string>app.oneum.dsf-audio</string>
        <string>app.oneum.dsdiff-audio</string>
        <string>org.matroska.mka</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>M3U Playlist</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>public.m3u-playlist</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Music Folder</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>None</string>
      <key>LSItemContentTypes</key>
      <array><string>public.folder</string></array>
    </dict>
  </array>
  <!-- Audio formats macOS has no type for. Declared as imported, so that a type another
       app declares for the same extension takes precedence. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>app.oneum.dsf-audio</string>
      <key>UTTypeDescription</key><string>DSD Stream File</string>
      <key>UTTypeConformsTo</key><array><string>public.audio</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>dsf</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>app.oneum.dsdiff-audio</string>
      <key>UTTypeDescription</key><string>DSDIFF Audio</string>
      <key>UTTypeConformsTo</key><array><string>public.audio</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>dff</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.matroska.mka</string>
      <key>UTTypeDescription</key><string>Matroska Audio</string>
      <key>UTTypeConformsTo</key><array><string>public.audio</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>mka</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
