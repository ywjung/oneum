<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one group of keychain items the widgets may reach: where the app leaves the
	     song they show. (Not the app's own group, where its passwords are.) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(ONEUM_BUNDLE_ID).nowplaying</string>
	</array>
</dict>
</plist>
